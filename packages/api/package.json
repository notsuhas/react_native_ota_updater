{
	"name": "@rentlydev/rnota-api",
	"version": "2.0.0",
	"type": "module",
	"exports": {
		"./routes": {
			"types": "./dist/routes/index.d.ts",
			"default": "./src/routes/index.ts"
		},
		"./app": {
			"types": "./dist/app.d.ts",
			"default": "./src/app.ts"
		},
		"./env": {
			"types": "./dist/env.d.ts",
			"default": "./src/env.ts"
		}
	},
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "tsc && tsc-alias",
		"start": "pnpm with-env node ./dist/index.js",
		"dev:next": "tsc && tsc-alias",
		"dev:api": "pnpm with-env tsx watch src/index.ts",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"clean-build": "rm -rf .cache .turbo .next dist",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"with-env": "dotenv -e ../../.env --"
	},
	"dependencies": {
		"@hono/node-server": "^2.0.0",
		"@hono/zod-openapi": "^1.3.0",
		"@rentlydev/rnota-auth": "workspace:*",
		"@rentlydev/rnota-aws": "workspace:*",
		"@rentlydev/rnota-db": "workspace:*",
		"@rentlydev/rnota-redis": "workspace:*",
		"@scalar/hono-api-reference": "^0.10.9",
		"@t3-oss/env-nextjs": "catalog:",
		"date-fns": "^4.1.0",
		"form-data": "^4.0.5",
		"hono": "catalog:",
		"hono-pino": "^0.10.3",
		"mime": "^4.1.0",
		"pino": "^10.3.1",
		"pino-pretty": "^13.1.3",
		"semver": "catalog:",
		"stoker": "^2.0.1",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@rentlydev/rnota-tsconfig": "workspace:*",
		"@types/node": "catalog:node22",
		"@types/semver": "^7.7.1",
		"dotenv-cli": "catalog:",
		"tsc-alias": "catalog:",
		"tsx": "catalog:"
	}
}
