{
	"name": "@rentlydev/rnota-cli",
	"description": "CLI tool for managing over-the-air updates for React Native apps",
	"version": "2.0.0",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"engines": {
		"node": ">=22"
	},
	"files": [
		"/bin",
		"/dist",
		"/oclif.manifest.json"
	],
	"keywords": [
		"oclif"
	],
	"bin": {
		"rnota": "./bin/run.js"
	},
	"scripts": {
		"build": "shx rm -rf dist && tsc -b",
		"dev": "pnpm postpack && node ./bin/dev.js",
		"clean": "git clean -xdf .cache .turbo tmp dist tsconfig.tsbuildinfo node_modules oclif.manifest.json",
		"clean-build": "rm -rf .cache .turbo .next dist tsconfig.tsbuildinfo",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false",
		"postpack": "shx rm -f oclif.manifest.json",
		"posttest": "pnpm run lint",
		"prepack": "oclif manifest && oclif readme",
		"test": "mocha --forbid-only \"test/**/*.test.ts\"",
		"version:cli": "oclif readme && git add README.md"
	},
	"dependencies": {
		"@alwatr/parse-duration": "^9.11.2",
		"@inquirer/prompts": "^8.4.2",
		"@listr2/prompt-adapter-enquirer": "^4.2.1",
		"@rentlydev/rnota-api-client": "workspace:*",
		"@oclif/core": "^4.10.5",
		"@oclif/plugin-help": "^6.2.44",
		"axios": "^1.15.2",
		"backslash": "^0.2.0",
		"chalk": "^5.6.2",
		"cli-table3": "^0.6.5",
		"conf": "^15.1.0",
		"date-fns": "^4.1.0",
		"gradle-to-js": "^2.0.1",
		"http-status-codes": "^2.3.0",
		"listr2": "^10.2.1",
		"opener": "^1.5.2",
		"plist": "^3.1.0",
		"properties": "^1.2.1",
		"rimraf": "^6.1.3",
		"semver": "catalog:",
		"slash": "5.1.0",
		"temp": "^0.9.4",
		"tsup": "^8.5.1",
		"which": "^6.0.1",
		"yauzl": "^3.3.0",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@rentlydev/rnota-tsconfig": "workspace:*",
		"@oclif/test": "^4.1.18",
		"@types/chai": "^5.2.3",
		"@types/mocha": "^10.0.10",
		"@types/node": "catalog:node22",
		"@types/opener": "^1.4.3",
		"@types/plist": "^3.0.5",
		"@types/semver": "^7.7.1",
		"@types/temp": "^0.9.4",
		"@types/which": "^3.0.4",
		"@types/yauzl": "^2.10.3",
		"@types/yazl": "^3.3.1",
		"chai": "^6.2.2",
		"mocha": "^11.7.5",
		"oclif": "^4.23.0",
		"shx": "^0.4.0",
		"ts-node": "^10.9.2",
		"tsc-alias": "catalog:"
	},
	"oclif": {
		"bin": "rnota",
		"dirname": "rnota",
		"commands": "./dist/commands",
		"plugins": [
			"@oclif/plugin-help"
		],
		"topicSeparator": " ",
		"macos": {
			"identifier": "com.rnota.cli"
		}
	}
}
