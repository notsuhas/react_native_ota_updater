{
	"name": "@rentlydev/rnota-auth",
	"version": "3.0.0",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/auth.d.ts",
			"default": "./src/auth.ts"
		},
		"./react": {
			"types": "./dist/react.d.ts",
			"default": "./src/react.ts"
		},
		"./session": {
			"types": "./dist/session.d.ts",
			"default": "./src/session.ts"
		},
		"./env": {
			"types": "./dist/env.d.ts",
			"default": "./src/env.ts"
		}
	},
	"files": [
		"/dist"
	],
	"scripts": {
		"build": "tsc && tsc-alias",
		"dev:next": "tsc && tsc-alias",
		"clean": "git clean -xdf .cache .turbo dist node_modules",
		"clean-build": "rm -rf .cache .turbo .next dist",
		"typecheck": "tsc --noEmit --emitDeclarationOnly false"
	},
	"dependencies": {
		"@rentlydev/rnota-db": "workspace:*",
		"@t3-oss/env-nextjs": "catalog:",
		"better-auth": "^1.6.8",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"next": "^16.0.0",
		"react": "^19.0.0"
	},
	"devDependencies": {
		"@rentlydev/rnota-tsconfig": "workspace:*",
		"@types/node": "catalog:node22",
		"tsc-alias": "catalog:"
	}
}
